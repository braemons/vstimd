target
.claude/worktrees/

# MkDocs build output
/site/
# Build artefacts from `make deb/rpm/image`. The image build also writes a
# plaintext *-credentials.txt here with the generated SSH/Samba password —
# this must never be committable.
/dist/
packaging/image/.cache/

packaging/*.deb
packaging/*.ddeb
packaging/*.rpm
packaging/*.changes
packaging/*.buildinfo

# Stray saved stim-configs from running the server with --config-dir . in the
# repo root (root-anchored so it never hides the server/tests/configs fixtures).
/vstimd_*.config.json
