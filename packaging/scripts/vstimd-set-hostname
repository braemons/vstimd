#!/bin/bash
# vstimd-set-hostname — derive and set a unique hostname from the primary
# network interface's MAC address.
#
# Naming scheme: vstimd-XXXXXX, where XXXXXX is the last 6 hex characters of
# the MAC (13 chars total, fits Samba's 15-char NetBIOS limit). Stable across
# reboots without needing persistent storage, and human-readable for
# debugging/matching against shares.
#
# Both Avahi and Samba inherit the system hostname by default (no
# host-name=/netbios name override needed), so setting it here is enough for
# both to advertise a unique, collision-resistant name on the LAN.
#
# Also renders the Avahi service template (see below) with the computed
# hostname baked in as a literal: Avahi's %h wildcard only works inside
# <name>, not <txt-record> (not a valid attribute there per
# avahi-service.dtd), so the stable id=... TXT record can't be produced by
# Avahi's own substitution and has to be written here instead.
#
# Must run before avahi-daemon, smbd, and nmbd start — see
# vstimd-hostname.service, which orders this ahead of them. Safe to run
# multiple times; idempotent if the hostname is already in vstimd-XXXXXX form.
set -euo pipefail

AVAHI_TEMPLATE="/usr/share/braemons/vstimd/vstimd.service.avahi.tmpl"
AVAHI_SERVICES_DIR="/etc/avahi/services"

die() { echo "vstimd-set-hostname: error: $*" >&2; exit 1; }

# Render the Avahi service file from the template if Avahi is installed
# (its services directory exists) and we ship the template. No-op otherwise.
render_avahi_service() {
    [ -f "$AVAHI_TEMPLATE" ] || return 0
    [ -d "$AVAHI_SERVICES_DIR" ] || return 0
    sed "s/@HOSTNAME@/${NEW_HOSTNAME}/" "$AVAHI_TEMPLATE" > "${AVAHI_SERVICES_DIR}/vstimd.service"
    echo "vstimd-set-hostname: rendered ${AVAHI_SERVICES_DIR}/vstimd.service (id=${NEW_HOSTNAME})"
}

# Keep the Debian-style "127.0.1.1 <hostname>" line in /etc/hosts in sync.
# hostnamectl/hostname -F only change the live kernel hostname and
# /etc/hostname — they never touch /etc/hosts — so without this, anything
# that resolves the local hostname via /etc/hosts (sudo, some getaddrinfo
# paths) starts failing right after the rename.
update_etc_hosts() {
    if grep -q '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
        sed -i "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t${NEW_HOSTNAME}/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$NEW_HOSTNAME" >> /etc/hosts
    fi
}

# Find the primary interface: prefer common wired-NIC names, else fall back
# to the first non-loopback interface that has a MAC address.
find_iface() {
    for candidate in eth0 end0 eno1; do
        if [ -e "/sys/class/net/$candidate/address" ]; then
            echo "$candidate"
            return 0
        fi
    done
    for path in /sys/class/net/*/address; do
        [ -e "$path" ] || continue
        dev=$(basename "$(dirname "$path")")
        [ "$dev" = "lo" ] && continue
        echo "$dev"
        return 0
    done
    return 1
}

# This unit runs deliberately early (Before=sysinit.target, see
# vstimd-hostname.service) — before network.target, and before udev has
# necessarily finished probing every device. On the Pi 5 the onboard NIC
# hangs off the RP1 southbridge over PCIe and can take a few seconds longer
# to enumerate than local-fs/systemd-udevd readiness alone guarantees, so the
# interface may not exist in /sys/class/net yet on the first check — retry
# for a bounded time instead of failing outright (this used to die()
# immediately here, which is why the hostname was never set on a real
# board even though the interface reliably showed up a moment later).
IFACE=""
DEADLINE=$(($(date +%s) + 20))
while [ -z "$IFACE" ]; do
    IFACE=$(find_iface || true)
    [ -n "$IFACE" ] && break
    [ "$(date +%s)" -lt "$DEADLINE" ] || break
    sleep 0.2
done
[ -n "$IFACE" ] || die "no network interface with a MAC address found (waited 20s)"

MAC=$(cat "/sys/class/net/$IFACE/address") || die "cannot read MAC for $IFACE"
SUFFIX=$(printf '%s' "$MAC" | tr -d ':' | tr '[:upper:]' '[:lower:]' | tail -c 6)
[ -n "$SUFFIX" ] || die "could not derive suffix from MAC '$MAC'"

NEW_HOSTNAME="vstimd-${SUFFIX}"
CURRENT_HOSTNAME=$(hostname)

if [ "$CURRENT_HOSTNAME" = "$NEW_HOSTNAME" ]; then
    echo "vstimd-set-hostname: hostname already set to $NEW_HOSTNAME — nothing to do"
else
    echo "vstimd-set-hostname: setting hostname to $NEW_HOSTNAME (from $IFACE MAC $MAC)"

    # Write /etc/hostname + call sethostname(2) directly rather than going
    # through hostnamectl: hostnamectl talks to systemd-hostnamed over D-Bus,
    # and this unit runs before sysinit.target — earlier than dbus.service is
    # guaranteed to be up — so routing through it here is fragile. The direct
    # path has no daemon dependency at all.
    echo "$NEW_HOSTNAME" > /etc/hostname
    hostname -F /etc/hostname

    update_etc_hosts

    # Belt-and-braces for the case this runs against an already-running
    # avahi-daemon/smbd/nmbd (manual re-run, NIC swap on a live system) —
    # on a normal boot these aren't started yet (see vstimd-hostname.service
    # ordering) so this is a no-op there. try-restart only acts on units
    # that are already active.
    systemctl try-restart avahi-daemon.service smb.service nmb.service 2>/dev/null || true
fi

# Always (re)render — covers first boot after Avahi is installed later, or
# after a package upgrade changes the template.
render_avahi_service
