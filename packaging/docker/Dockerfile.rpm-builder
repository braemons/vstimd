# Multi-stage build: compile on Ubuntu (cross-compilation tooling available),
# package on AlmaLinux 9 (rpmbuild + systemd macros).
#
# Usage (x86_64, AlmaLinux 9):
#   docker build -f packaging/docker/Dockerfile.rpm-builder -t vstimd-rpm-builder .
#   docker run --rm -v $(pwd)/dist:/output vstimd-rpm-builder
#
# Cross-compile for aarch64 (Jetson / Raspberry Pi):
#   docker build -f packaging/docker/Dockerfile.rpm-builder \
#     --build-arg RUST_TARGET=aarch64-unknown-linux-gnu \
#     --build-arg RPM_ARCH=aarch64 \
#     -t vstimd-rpm-builder-arm64 .

ARG BUILD_IMAGE=ubuntu:22.04
ARG PACK_IMAGE=almalinux:9

# ── Stage 1: cross-compile ────────────────────────────────────────────────────
FROM ${BUILD_IMAGE} AS builder

ARG RUST_TARGET=x86_64-unknown-linux-gnu

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_AARCH64_UNKNOWN_LINUX_GNU=/usr/local/bin/aarch64-linux-gnu-pkg-config

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
        build-essential pkg-config \
        libinput-dev libudev-dev libdrm-dev libwayland-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# arm64 cross-compilation setup (no-op for native amd64 builds).
RUN if [ "${RUST_TARGET}" = "aarch64-unknown-linux-gnu" ]; then \
        dpkg --add-architecture arm64 && \
        sed -i 's/^deb /deb [arch=amd64] /g' /etc/apt/sources.list && \
        printf "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy main restricted universe multiverse\n\
deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-updates main restricted universe multiverse\n\
deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-security main restricted universe multiverse\n" \
            >> /etc/apt/sources.list && \
        apt-get update && apt-get install -y --no-install-recommends \
            gcc-aarch64-linux-gnu \
            libinput-dev:arm64 libudev-dev:arm64 libdrm-dev:arm64 libwayland-dev:arm64 && \
        rm -rf /var/lib/apt/lists/* && \
        mkdir -p ${CARGO_HOME} && \
        printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n' \
            >> ${CARGO_HOME}/config.toml && \
        printf '#!/bin/sh\nexec env PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig pkg-config "$@"\n' \
            > /usr/local/bin/aarch64-linux-gnu-pkg-config && \
        chmod +x /usr/local/bin/aarch64-linux-gnu-pkg-config; \
    fi

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    && rustup target add ${RUST_TARGET}

# Node.js for building the embedded web UI bundle (baked in via `embed-ui`).
# Ubuntu's apt nodejs is too old for Vite/buf, so use NodeSource 22.x. The
# bundle is plain static JS, built for the build host arch even when cross-compiling.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
# The build recipes live here (see `make build` / `make print-version` below)
# rather than being restated in this Dockerfile.
COPY Makefile ./
COPY server/ server/
COPY vtl/ vtl/
# A workspace member: cargo refuses to load the workspace without it, even
# though this image only packages vstimd itself.
COPY gpiochip-daqd/ gpiochip-daqd/
COPY proto/ proto/
COPY client/web/ client/web/

# Build the React UI first so `--features embed-ui` can bake client/web/dist
# into the binary. Kept as its own layer so a Rust-only change does not redo
# the npm work. NPM_INSTALL="npm ci" for a lockfile-exact, reproducible install.
RUN make web NPM_INSTALL="npm ci"

# The build context has no .git, so the version cannot be derived in here: the
# Makefile computes it on the host and passes it down, and `make` below picks it
# up from the environment. No default on purpose — an unset value makes the
# Makefile abort rather than invent a version.
#
# Declared *here* rather than beside RUST_TARGET at the top, because an ARG
# invalidates its own layer and every layer after it. The version changes with
# every commit (git describe appends a distance suffix), so declaring it early
# would re-run apt, rustup and npm on every single build. Everything above this
# line is version-independent and stays cached; `make web` runs before it
# because the web bundle embeds no version.
ARG VSTIMD_VERSION
ENV VSTIMD_VERSION=${VSTIMD_VERSION}

# `make build` = web + cargo build --features embed-ui, and print-binary /
# print-version come from the same Makefile variables the .deb path uses — so
# the binary path and the crate version are not re-derived here. (This file
# used to re-implement the version parse with a stricter regex than the
# Makefile's, which silently breaks on an aligned `version = "..."`.)
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git \
    --mount=type=cache,target=/src/target,id=cargo-target-${RUST_TARGET} \
    make build RUST_TARGET=${RUST_TARGET} && \
    cp "$(make -s print-binary RUST_TARGET=${RUST_TARGET})" /vstimd && \
    make -s print-version > /version

# ── Stage 2: package ──────────────────────────────────────────────────────────
FROM ${PACK_IMAGE} AS packager

ARG RPM_ARCH=x86_64

RUN dnf install -y rpm-build systemd-rpm-macros \
    && dnf clean all

# /build acts as %{_builddir} so %install paths resolve correctly.
WORKDIR /build

# The whole tree, not a hand-picked subset: %install also reaches for
# packaging/scripts, packaging/rsyslog, packaging/logrotate and
# packaging/avahi, and a missing one only shows up as an rpmbuild failure.
COPY packaging/ packaging/
COPY packaging/rpm/vstimd.spec /root/rpmbuild/SPECS/vstimd.spec

COPY --from=builder /vstimd  target/release/vstimd
COPY --from=builder /version /version

RUN chmod 0755 target/release/vstimd

RUN mkdir -p /root/rpmbuild/{BUILD,RPMS,SOURCES,SPECS,SRPMS}

RUN VERSION=$(cat /version) && \
    rpmbuild -bb \
        --define "_topdir /root/rpmbuild" \
        --define "_builddir /build" \
        --define "pkg_version $VERSION" \
        --target ${RPM_ARCH} \
        /root/rpmbuild/SPECS/vstimd.spec

RUN mkdir -p /out && find /root/rpmbuild/RPMS -name '*.rpm' -exec cp {} /out/ \;

CMD ["bash", "-c", "cp /out/*.rpm /output/ && echo 'RPM copied to /output/'"]
